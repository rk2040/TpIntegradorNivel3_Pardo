<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.master.cs" Inherits="catalogo_web.Master" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body style="padding-top: 75px">
    <form id="form1" runat="server">
        <div>
            <nav class="navbar navbar-expand-lg bg-dark fixed-top" data-bs-theme="dark">
                <div class="container-fluid">
                    <a class="navbar-brand" href="Default.aspx">Catalogo-web</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                        <div class="navbar-nav">
                            <a class="nav-link" href="ArticulosLista.aspx">Lista de Articulos</a>
                            <a class="nav-link" href="MiPerfil.aspx">Mi Perfil</a>
                            <a class="nav-link" href="Favoritos.aspx">Favoritos</a>
                            <a class="nav-link disabled" aria-disabled="true">Disabled</a>
                        </div>
                    </div>

                    <div class="d-flex" style="flex-wrap:wrap; ">
                        
                        <%if (!negocio.Seguridad.sesionActiva(Session["usuario"]))
    { %>
                        <<asp:HyperLink href="Login.aspx" CssClass="btn btn-primary mx-1" runat="server">Login</asp:HyperLink>
                        <<asp:HyperLink href="Registro.aspx" CssClass="btn btn-outline-danger  mx-1" runat="server">Registrarse</asp:HyperLink>
                        <%  } %>
                        <%else
    { %>
                        <asp:Label ID="lblUser" Text="user" CssClass="text-light m-auto  mx-2" runat="server" />
                        <asp:Image ID="imgAvatar" CssClass=" mx-1" Style="height: 40px; width: 40px; border-radius: 50%" runat="server" />
                        <asp:Button ID="btnSalir" Text="Salir" CssClass="btn btn-outline-danger" OnClick="btnSalir_Click" runat="server" />
                        <%  } %>
                        <%-- Imagen de perfil, ya fuera edl if else --%>
                    </div>
                </div>
            </nav>

            <div class="container">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
